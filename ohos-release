#!/bin/sh
# Package without deleting/overwriting existing build or distribution contents.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ARCH=${1:-aarch64}
case "$ARCH" in
  aarch64|arm64|arm64-v8a)
    ABI=arm64-v8a
    LABEL=aarch64-linux-ohos
    ;;
  armv7|armv7a|armeabi-v7a)
    ABI=armeabi-v7a
    LABEL=armv7-linux-ohos
    ;;
  x86_64)
    ABI=x86_64
    LABEL=x86_64-linux-ohos
    ;;
  *)
    echo "unsupported arch: $ARCH" >&2
    exit 1
    ;;
esac

cd "$ROOT"

# Keep the BSD-sed compatibility local instead of changing script-helper.
VERSION=$(sed -n 's/^AC_INIT(\[aria2\],\[\([^]]*\)\].*/\1/p' configure.ac)
if [ -z "$VERSION" ]; then
  echo "No version found" >&2
  exit 1
fi

SOURCE=${OHOS_OUT_DIR:-$ROOT/ohos-out/$ABI}
if [ ! -f "$SOURCE/artifact-manifest.json" ]; then
  echo "missing shared-artifact manifest (run ./ohos-config $ARCH first)" >&2
  exit 1
fi
if [ ! -f "$SOURCE/lib/libaria2.so" ] || [ -L "$SOURCE/lib/libaria2.so" ] || \
  [ -e "$SOURCE/libaria2.so" ] || [ -L "$SOURCE/libaria2.so" ] || \
  [ -n "$(find "$SOURCE" -type l -print)" ] || \
  [ -n "$(find "$SOURCE" -name 'libaria2.so.*' -print)" ]; then
  echo 'package requires ordinary lib/libaria2.so; symlinks, versioned files and top-level aliases are forbidden' >&2
  exit 1
fi
jq -e '.library.path == "lib/libaria2.so" and .soname == "libaria2.so" and
  .artifact_layout.shared_library == "regular-file" and
  .artifact_layout.symlinks == false and
  .artifact_layout.versioned_library_files == false and
  .artifact_layout.top_level_library_alias == false' "$SOURCE/artifact-manifest.json" >/dev/null
(cd "$SOURCE" && shasum -a 256 -c SHA256SUMS)

BUILD_VER=${BUILD_VER:-1}
DIST_DIR=aria2-${VERSION}-${LABEL}-shared-build${BUILD_VER}
PACKAGE_ROOT=${OHOS_PACKAGE_DIR:-$ROOT/ohos-packages}
mkdir -p "$PACKAGE_ROOT"
if [ -e "$PACKAGE_ROOT/$DIST_DIR" ] || [ -e "$PACKAGE_ROOT/$DIST_DIR.zip" ] || \
  [ -e "$PACKAGE_ROOT/$DIST_DIR.tar.gz" ] || [ -e "$PACKAGE_ROOT/$DIST_DIR.packages.sha256" ]; then
  echo "package exists; choose fresh BUILD_VER/OHOS_PACKAGE_DIR" >&2
  exit 1
fi
cp -R "$SOURCE" "$PACKAGE_ROOT/$DIST_DIR"
cd "$PACKAGE_ROOT"
zip -9 -r "$DIST_DIR.zip" "$DIST_DIR"
tar -czf "$DIST_DIR.tar.gz" "$DIST_DIR"
shasum -a 256 "$DIST_DIR.zip" "$DIST_DIR.tar.gz" > "$DIST_DIR.packages.sha256"
echo "Packages retained: $PACKAGE_ROOT/$DIST_DIR.{zip,tar.gz}"
